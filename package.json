{
	"name": "apple-podcast-transcript-extractor",
	"version": "0.2.0",
	"description": "Extract transcripts from Apple Podcasts on macOS",
	"scripts": {
		"tauri": "tauri",
		"dev": "tauri dev",
		"build": "tauri build",
		"test": "cd src-tauri && cargo test",
		"release": "node release.js",
		"test:reset-permissions": "sudo tccutil reset All com.mattdanielmurphy.podcast-transcript-extractor",
		"test:open-app": "open 'src-tauri/target/release/bundle/macos/Transcript Extractor.app'"
	},
	"dependencies": {
		"sqlite3": "^5.1.6",
		"xml2js": "^0.6.2"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.12.6"
	}
}
