{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Transcript Extractor",
  "version": "0.1.1",
  "identifier": "com.mattdanielmurphy.podcast-transcript-extractor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Transcript Extractor",
        "width": 1200,
        "height": 800,
        "minWidth": 955,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#14141a"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}